# Local development only. Set strong credentials and API_KEY before exposing the service.
POSTGRES_USER=logservice
POSTGRES_PASSWORD=local-development
POSTGRES_DB=logservice
DATABASE_URL=postgresql://logservice:local-development@localhost:5432/logservice
REDIS_URL=redis://localhost:6379/0
API_KEY=
MAX_REQUEST_BYTES=16384
QUEUE_CAPACITY=100000
RECLAIM_IDLE_MS=30000
MAX_ATTEMPTS=5
DB_TIMEOUT_MS=5000
ALERT_WINDOW_SECONDS=60
ALERT_MIN_EVENTS=20
ALERT_MIN_ERRORS=5
ALERT_ERROR_RATIO=0.25
ALERT_SUSTAIN_SECONDS=30
ALERT_COOLDOWN_SECONDS=300
ALERT_CHECK_SECONDS=5
